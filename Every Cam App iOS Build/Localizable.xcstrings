    "„%@“ hat bereits zugeordnete Aufnahmen. Verschiebe oder lösche sie zuerst in der Galerie, bevor der Tag entfernt werden kann.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” already has assigned captures. Move or delete them first in the gallery before the tag can be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ya tiene grabaciones asignadas. Muévelas o elimínalas primero en la galería antes de poder quitar la etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” a déjà des captures attribuées. Déplacez-les ou supprimez-les d'abord dans la galerie avant de pouvoir supprimer le tag."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” ha già acquisizioni assegnate. Spostale o eliminale prima nella galleria per poter rimuovere il tag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” heeft al toegewezen opnames. Verplaats of verwijder ze eerst in de galerie voordat de tag kan worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@” ma już przypisane ujęcia. Najpierw przenieś je lub usuń w galerii, zanim będzie można usunąć tag."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” já tem gravações atribuídas. Mova ou exclua-as primeiro na galeria antes que a tag possa ser removida."
          }
        }
      }
    },
    "„%@“ und alle %lld Aufnahmen werden unwiderruflich gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden.": {
      "comment": "A warning message that informs the user that the selected collections and their captures will be permanently deleted.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "„%1$@“ und alle %2$lld Aufnahmen werden unwiderruflich gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and all %2$lld captures will be irrevocably deleted. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” y las %2$lld grabaciones se eliminarán de forma irrevocable. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” et les %2$lld captures seront supprimées de manière irrévocable. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e tutte le %2$lld acquisizioni verranno eliminate in modo irrevocabile. Questa azione non può essere annullata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” en alle %2$lld opnames worden onherroepelijk verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@” i wszystkie %2$lld ujęcia zostaną nieodwracalnie usunięte. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” e todas as %2$lld gravações serão excluídas de forma irrevogável. Esta ação não pode ser desfeita."
          }
        }
      }
    },
