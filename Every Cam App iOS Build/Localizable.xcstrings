    "%lld Aufnahmen werden endgültig gelöscht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld captures will be permanently deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente %lld grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld captures seront définitivement supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld acquisizioni verranno eliminate definitivamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld opnames worden definitief verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ujęć zostanie trwale usuniętych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gravações serão excluídas permanentemente."
          }
        }
      }
    },
    "%lld Sammlungen werden inklusive aller Aufnahmen endgültig gelöscht.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld collections will be permanently deleted, including all captures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente %lld colecciones, incluidas todas las grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld collections seront définitivement supprimées, avec toutes les captures qu'elles contiennent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld raccolte verranno eliminate definitivamente, incluse tutte le acquisizioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld collecties worden definitief verwijderd, inclusief alle opnames."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kolekcji zostanie trwale usuniętych wraz ze wszystkimi ujęciami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld coleções serão excluídas permanentemente, incluindo todas as gravações."
          }
        }
      }
    },
    "%lld Sammlungen werden unwiderruflich gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld collections will be irrevocably deleted. This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán %lld colecciones de forma irrevocable. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld collections seront supprimées de manière irrévocable. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld raccolte verranno eliminate in modo irrevocabile. Questa azione non può essere annullata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld collecties worden onherroepelijk verwijderd. Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld kolekcji zostanie nieodwracalnie usuniętych. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld coleções serão excluídas de forma irrevogável. Esta ação não pode ser desfeita."
          }
        }
      }
    },
