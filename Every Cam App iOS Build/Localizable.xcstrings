    "%@ wird inklusive aller %lld Aufnahmen endgültig gelöscht.": {
      "comment": "A message that informs the user that a collection and all its captures will be permanently deleted.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ wird inklusive aller %2$lld Aufnahmen endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ will be permanently deleted, including all %2$lld captures."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se eliminará permanentemente, incluidas todas las %2$lld grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sera définitivement supprimée, avec les %2$lld captures qu'elle contient."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verrà eliminata definitivamente, incluse tutte le %2$lld acquisizioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wordt definitief verwijderd, inclusief alle %2$lld opnames."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ zostanie trwale usunięta wraz ze wszystkimi %2$lld ujęciami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ será excluída permanentemente, incluindo todas as %2$lld gravações."
          }
        }
      }
    },
