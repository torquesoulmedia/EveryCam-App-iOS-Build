    "Bereits heute in anderen Sammlungen angelegt — antippen zum Übernehmen.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Already added to other collections today — tap to adopt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se añadió hoy a otras colecciones — toca para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà ajouté à d'autres collections aujourd'hui — touchez pour reprendre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Già aggiunto ad altre raccolte oggi — tocca per usarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag al aan andere collecties toegevoegd — tik om over te nemen."
