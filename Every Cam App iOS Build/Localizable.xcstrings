    "" : {

    },
    "„%@“ hat bereits zugeordnete Clips. Verschiebe oder lösche sie zuerst in der Galerie, bevor der Athlet entfernt werden kann." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ hat bereits zugeordnete Clips. Verschiebe oder lösche sie zuerst in der Galerie, bevor der Athlet entfernt werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” already has assigned clips. Move or delete them in the gallery first before this athlete can be removed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» ya tiene clips asignados. Muévelos o elimínalos primero en la galería antes de poder eliminar al atleta."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" já tem clipes atribuídos. Mova-os ou exclua-os primeiro na galeria antes que o atleta possa ser removido."
          }
        }
      }
    },
    "„%@“ und alle %lld Clips werden unwiderruflich gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und alle %lld Clips werden unwiderruflich gelöscht. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and all %lld clips will be irrevocably deleted. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y los %lld clips se eliminarán de forma irrevocable. Esta acción no se puede deshacer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" e todos os %lld clipes serão excluídos de forma irreversível. Esta ação não pode ser desfeita."
          }
        }
      }
    },
    "%@ – %@" : {
