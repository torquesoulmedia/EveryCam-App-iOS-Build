        }
      }
    },
    "%@ – %@": {
      "comment": "A label displaying a session's date and name. The first argument is the formatted date of the session. The second argument is the session's name.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ – %2$@"
          }
        }
      }
    },
    "%lld Aufnahmen": {
      "comment": "Anzahl der Aufnahmen im Kopfbereich einer",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld captures"
          }
        },
        "es": {
